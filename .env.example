# Set ONE of these. Featherless.AI is the recommended primary path
# (sponsor of JacHacks Spring 2026 — free tier, open-weight models).
# Get a key: https://featherless.ai/account/api-keys

FEATHERLESS_API_KEY=your-key-here

# Optional override — pick a different Featherless model.
# Default is openai/Qwen/Qwen2.5-14B-Instruct (fast, concurrency_cost=1).
# 72B is more accurate but slower (concurrency_cost=4).
# SUBKILLER_MODEL=openai/Qwen/Qwen2.5-72B-Instruct

# --- Alternatives (used only if FEATHERLESS_API_KEY is unset) ---
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here
